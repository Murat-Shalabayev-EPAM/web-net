@using Northwind.Models.ViewModels
@model IEnumerable<CategoryViewModel>

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Category List</h2>
        </div>
    </div>
    <br /> <br />
    @await Component.InvokeAsync("Breadcrumb")
    <table class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                <th>
                    Category Name
                </th>
                <th>
                    Description
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach(var category in Model)
            {
                <tr>
                    <td width="20%">@category.CategoryName</td>
                    <td width="30%">@category.Description</td>
                    <td width="40%">
                    @if(category.Picture != null)
                    {
                        <img src="data:image/bmp;base64,@Convert.ToBase64String(category.Picture)" width="200" />
                    }
                    </td>
                    <td width="10%">
                        <a asp-controller="Category" asp-route-Id="@category.CategoryID" asp-action="Edit" class="btn btn-primary">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
